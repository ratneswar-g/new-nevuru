{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@neravu/shared-types": [
        "../shared-types/src/index.ts"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src"
  ]
}
