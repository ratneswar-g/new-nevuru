# ==========================================
# NERAVU BACKEND ENVIRONMENT CONFIGURATION (TEMPLATE)
# ZERO SECRETS COMMITTED. REPLACE PLACEHOLDERS IN LOCAL .env.
# ==========================================

# Django Configuration
DJANGO_SETTINGS_MODULE="config.settings.local"
DJANGO_SECRET_KEY="replace-with-a-secure-random-secret-key"
DEBUG=True
ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# Authoritative PostgreSQL Database (Neon Managed PostgreSQL or Local)
# When using Neon, provide NEON_DATABASE_URL in AI Studio Secrets or local .env:
NEON_DATABASE_URL="postgresql://user:password@endpoint.neon.tech/neravu_dev?sslmode=require"
POSTGRES_DB="neravu_dev"
POSTGRES_USER="neravu_user"
POSTGRES_PASSWORD="replace_with_db_password"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:5174"

# External Providers (To be configured in respective phases)
SMS_GATEWAY_API_KEY=""
SMS_GATEWAY_SENDER_ID=""
FCM_SERVER_KEY=""
MAPS_API_KEY=""

# Firebase Admin: path to a service-account JSON kept OUTSIDE the repo
FIREBASE_CREDENTIALS_PATH=""
OTP_TTL_MINUTES=30
OTP_MAX_ATTEMPTS=3
