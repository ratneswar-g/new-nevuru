{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-native",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@neravu/shared-types": [
        "../../packages/shared-types/src/index.ts"
      ],
      "@neravu/api-client": [
        "../../packages/api-client/src/index.ts"
      ]
    },
    "lib": [
      "ES2022"
    ],
    "noEmit": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
